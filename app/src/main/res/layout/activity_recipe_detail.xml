<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Изображение рецепта -->
        <ImageView
            android:id="@+id/recipeImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/recipe_image" />

        <!-- Название рецепта -->
        <TextView
            android:id="@+id/recipeTitle"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Название рецепта"/>

        <!-- Ингредиенты -->
        <TextView
            android:id="@+id/ingredients"
            android:text="Ингредиенты: Картофель, Морковь, Лук..."
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Описание рецепта -->
        <TextView
            android:id="@+id/description"
            android:text="Описание: Вкусное и питательное блюдо..."
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Поле для ввода комментария -->
        <EditText
            android:id="@+id/commentInput"
            android:hint="Оставьте комментарий"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="4"
            android:maxLines="6"
            android:scrollbars="vertical"/>

        <!-- Кнопка для добавления комментария -->
        <Button
            android:id="@+id/addCommentBtn"
            android:text="Добавить комментарий"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
